# Bridge Worker - Environment Variables
# Copy this file to .env and fill in your values.

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://dcwszmpeelcdtdioedhi.supabase.co
# Get this from: Supabase Dashboard → Project Settings → API → service_role (secret)
# NEVER expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── MQTT (HiveMQ Cloud or any MQTT broker) ───────────────────
# Leave MQTT_URL blank to auto-enable the hardware simulator
MQTT_URL=mqtts://<cluster-id>.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=
MQTT_PASSWORD=

# ── Simulator mode ───────────────────────────────────────────
# Set to "true" to run the mock hardware simulator instead of real MQTT
# If MQTT_URL is not set, simulator is always used regardless of this flag
SIMULATE_HARDWARE=true

# ── Alert threshold ───────────────────────────────────────────
SPIKE_THRESHOLD_WATTS=1200
